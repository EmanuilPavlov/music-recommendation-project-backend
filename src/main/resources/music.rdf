@prefix : <http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#> .

<http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#affectsState
:affectsState rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Song ;
              rdfs:range :State .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#containsSong
:containsSong rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Playlist ;
              rdfs:range :Song .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasEffect
:hasEffect rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :Song ;
           rdfs:range :Effect .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasGenre
:hasGenre rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain :Emotion ,
                      :Song ;
          rdfs:range :SongAccordingToGenre .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasMedicalCondition
:hasMedicalCondition rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdfs:domain :UserProfile ;
                     rdfs:range :MedicalCondition .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasMentalState
:hasMentalState rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain :UserProfile ;
                rdfs:range :MentalState .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasMood
:hasMood rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :Song ;
         rdfs:range :Emotion .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasPhysicalState
:hasPhysicalState rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain :UserProfile ;
                  rdfs:range :PhysicalState .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasPlaylist
:hasPlaylist rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :UserProfile ;
             rdfs:range :Playlist .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasSymptom
:hasSymptom rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :MedicalCondition ;
            rdfs:range :Symptom .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasTempo
:hasTempo rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdf:type owl:FunctionalProperty ;
          rdfs:domain :Song ;
          rdfs:range :SongAccordingToTempo .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#performedBy
:performedBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             owl:inverseOf :performes ;
             rdfs:domain :Song ;
             rdfs:range :Artist .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#performes
:performes rdf:type owl:ObjectProperty ;
           rdfs:domain :Artist ;
           rdfs:range :Song .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#playlistActivity
:playlistActivity rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Playlist ;
                  rdfs:range :Activity .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#playlistMood
:playlistMood rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Playlist ;
              rdfs:range :Emotion .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#prefersGenre
:prefersGenre rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :UserProfile ;
              rdfs:range :SongAccordingToGenre .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#prefersTempo
:prefersTempo rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :UserProfile ;
              rdfs:range :SongAccordingToTempo .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#recommendedForState
:recommendedForState rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdfs:domain :Song ;
                     rdfs:range :State .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasBPM
:hasBPM rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdf:type owl:FunctionalProperty ;
        rdfs:domain :Song ;
        rdfs:range xsd:int .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasDuration
:hasDuration rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :Song ;
             rdfs:range xsd:int .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasHz
:hasHz rdf:type owl:DatatypeProperty ,
                owl:FunctionalProperty ;
       rdfs:domain :Song ;
       rdfs:range xsd:int .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasPopularity
:hasPopularity rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Song ;
               rdfs:range xsd:int .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasTitle
:hasTitle rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdf:type owl:FunctionalProperty ;
          rdfs:domain :Song ;
          rdfs:range xsd:string .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#hasYear
:hasYear rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdf:type owl:FunctionalProperty ;
         rdfs:domain :Song ;
         rdfs:range xsd:int .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#ADHD
:ADHD rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :MedicalCondition
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasSymptom ;
                                                   owl:someValuesFrom :BrainFog
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasSymptom ;
                                                   owl:someValuesFrom :Distractibility
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasSymptom ;
                                                   owl:someValuesFrom :PoorConcentration
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :MedicalCondition .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Activity
:Activity rdf:type owl:Class .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Afrobeat
:Afrobeat rdf:type owl:Class ;
          rdfs:subClassOf :WorldMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#AlternativeRock
:AlternativeRock rdf:type owl:Class ;
                 rdfs:subClassOf :RockMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Ambient
:Ambient rdf:type owl:Class ;
         rdfs:subClassOf :ElectronicMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Angry
:Angry rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :Emotion
                                                  [ rdf:type owl:Class ;
                                                    owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :hasGenre ;
                                                                    owl:someValuesFrom :Metal
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :hasGenre ;
                                                                    owl:someValuesFrom :RockMusic
                                                                  ]
                                                                )
                                                  ]
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :hasTempo ;
                                                    owl:someValuesFrom :FastTempoSong
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :Emotion .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Anxiety
:Anxiety rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( :MedicalCondition
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :hasSymptom ;
                                                      owl:someValuesFrom :AnxietySymptom
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :hasSymptom ;
                                                      owl:someValuesFrom :Restlessness
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :hasSymptom ;
                                                      owl:someValuesFrom :Tension
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
         rdfs:subClassOf :MedicalCondition .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#AnxietyReductionEffect
:AnxietyReductionEffect rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :AnxietyReductionEffect
                                                                   [ rdf:type owl:Class ;
                                                                     owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasGenre ;
                                                                                     owl:someValuesFrom :Ambient
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasGenre ;
                                                                                     owl:someValuesFrom :Chillout
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasGenre ;
                                                                                     owl:someValuesFrom :ClassicalMusic
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasGenre ;
                                                                                     owl:someValuesFrom :Lo-fi
                                                                                   ]
                                                                                 )
                                                                   ]
                                                                   [ rdf:type owl:Class ;
                                                                     owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasTempo ;
                                                                                     owl:someValuesFrom :FastTempoSong
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasTempo ;
                                                                                     owl:someValuesFrom :MediumTempoSong
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasTempo ;
                                                                                     owl:someValuesFrom :SlowTempoSong
                                                                                   ]
                                                                                 )
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf :TherapeuticEffect .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#AnxietyReliefSong
:AnxietyReliefSong rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :AnxietyReliefSong
                                                              [ rdf:type owl:Class ;
                                                                owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :hasEffect ;
                                                                                owl:someValuesFrom :AnxietyReductionEffect
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :hasEffect ;
                                                                                owl:someValuesFrom :RelaxationEffect
                                                                              ]
                                                                            )
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :hasMedicalCondition ;
                                                                owl:someValuesFrom :Anxiety
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :SongAccordingToCondition .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#AnxietySymptom
:AnxietySymptom rdf:type owl:Class ;
                rdfs:subClassOf :EmotionalSymptom .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Apathy
:Apathy rdf:type owl:Class ;
        rdfs:subClassOf :EmotionalSymptom .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Artist
:Artist rdf:type owl:Class .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Bachata
:Bachata rdf:type owl:Class ;
         rdfs:subClassOf :LatinMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#BalkanMusic
:BalkanMusic rdf:type owl:Class ;
             rdfs:subClassOf :WorldMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Band
:Band rdf:type owl:Class ;
      rdfs:subClassOf :Artist .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Baroque
:Baroque rdf:type owl:Class ;
         rdfs:subClassOf :ClassicalMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Bebop
:Bebop rdf:type owl:Class ;
       rdfs:subClassOf :Jazz ;
       owl:disjointWith :Swing .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#BlackMetal
:BlackMetal rdf:type owl:Class ;
            rdfs:subClassOf :Metal .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Blues
:Blues rdf:type owl:Class ;
       rdfs:subClassOf :SongAccordingToGenre .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#BrainFog
:BrainFog rdf:type owl:Class ;
          rdfs:subClassOf :CognitiveSymptom .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#BurnoutFeeling
:BurnoutFeeling rdf:type owl:Class ;
                rdfs:subClassOf :EnergySymptom .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Calm
:Calm rdf:type owl:Class ;
      rdfs:subClassOf :RelaxationState ;
      owl:disjointWith :Stressed .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#ChicagoBlues
:ChicagoBlues rdf:type owl:Class ;
              rdfs:subClassOf :Blues .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Chillout
:Chillout rdf:type owl:Class ;
          rdfs:subClassOf :Hybrid .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#ClassicalMusic
:ClassicalMusic rdf:type owl:Class ;
                rdfs:subClassOf :SongAccordingToGenre .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Coding
:Coding rdf:type owl:Class ;
        rdfs:subClassOf :Activity .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#CognitiveEffect
:CognitiveEffect rdf:type owl:Class ;
                 rdfs:subClassOf :Effect .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#CognitiveState
:CognitiveState rdf:type owl:Class ;
                rdfs:subClassOf :MentalState .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#CognitiveSymptom
:CognitiveSymptom rdf:type owl:Class ;
                  rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#ConcentrationBoost
:ConcentrationBoost rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :ConcentrationBoost
                                                               [ rdf:type owl:Class ;
                                                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasGenre ;
                                                                                 owl:someValuesFrom :Ambient
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasGenre ;
                                                                                 owl:someValuesFrom :ClassicalMusic
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasGenre ;
                                                                                 owl:someValuesFrom :Jazz
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasGenre ;
                                                                                 owl:someValuesFrom :Lo-fi
                                                                               ]
                                                                             )
                                                               ]
                                                               [ rdf:type owl:Class ;
                                                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasTempo ;
                                                                                 owl:someValuesFrom :MediumTempoSong
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasTempo ;
                                                                                 owl:someValuesFrom :SlowTempoSong
                                                                               ]
                                                                             )
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :CognitiveEffect .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :FolkMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#CreativityEnhancement
:CreativityEnhancement rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :CreativityEnhancement
                                                                  [ rdf:type owl:Class ;
                                                                    owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty :hasGenre ;
                                                                                    owl:someValuesFrom :Ambient
                                                                                  ]
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty :hasGenre ;
                                                                                    owl:someValuesFrom :ClassicalMusic
                                                                                  ]
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty :hasGenre ;
                                                                                    owl:someValuesFrom :Jazz
                                                                                  ]
                                                                                )
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :hasTempo ;
                                                                    owl:someValuesFrom :MediumTempoSong
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf :CognitiveEffect .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#DJ
:DJ rdf:type owl:Class ;
    rdfs:subClassOf :Artist .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#DancePop
:DancePop rdf:type owl:Class ;
          rdfs:subClassOf :PopularMusic .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#DeathMetal
:DeathMetal rdf:type owl:Class ;
            rdfs:subClassOf :Metal .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#DeltaBlues
:DeltaBlues rdf:type owl:Class ;
            rdfs:subClassOf :Blues .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Dementia
:Dementia rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :MedicalCondition
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasSymptom ;
                                                       owl:someValuesFrom :AnxietySymptom
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasSymptom ;
                                                       owl:someValuesFrom :Apathy
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasSymptom ;
                                                       owl:someValuesFrom :MemoryProblems
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasSymptom ;
                                                       owl:someValuesFrom :MentalFatigue
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasSymptom ;
                                                       owl:someValuesFrom :PoorConcentration
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :MedicalCondition .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#DementiaCareSong
:DementiaCareSong rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :DementiaCareSong
                                                             [ rdf:type owl:Class ;
                                                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasEffect ;
                                                                               owl:someValuesFrom :MemorySupport
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasEffect ;
                                                                               owl:someValuesFrom :RelaxationEffect
                                                                             ]
                                                                           )
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasMedicalCondition ;
                                                               owl:someValuesFrom :Dementia
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :SongAccordingToCondition .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#Depression
:Depression rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :MedicalCondition
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasSymptom ;
                                                         owl:someValuesFrom :Apathy
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasSymptom ;
                                                         owl:someValuesFrom :EmotionalOverload
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasSymptom ;
                                                         owl:someValuesFrom :Exhaustion
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasSymptom ;
                                                         owl:someValuesFrom :LackOfMotivation
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasSymptom ;
                                                         owl:someValuesFrom :LowEnergy
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :MedicalCondition .


###  http://www.semanticweb.org/emanuilpavlov/ontologies/2026/4/music#DepressionFriendlySong
:DepressionFriendlySong rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :DepressionFriendlySong
                                                                   [ rdf:type owl:Class ;
                                                                     owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasEffect ;
                                                                                     owl:someValuesFrom :EnergyBoost
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasEffect ;
                                                                                     owl:someValuesFrom :MoodImprovementEffect
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasEffect ;
                                                                                     owl:someValuesFrom :RelaxationEffect
                                                                                   ]
                                                                                 )
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasMedicalCondition ;
                                                                     owl:someValuesFrom :Depression
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
